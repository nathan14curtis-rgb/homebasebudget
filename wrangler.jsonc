{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "curtisclan",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // One binding per environment layer described in PLAN.md §2/§4/§10.
  // Real IDs are created with `wrangler d1 create curtisclan` and filled
  // in before deploy — see README "Deploying for real".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "curtisclan",
      "database_id": "60ec9b03-dc57-49b5-bc7c-e247bdf27eee",
      "migrations_dir": "migrations"
    }
  ],

  // Two queues (PLAN §5.0: "make sure the send path queues rather than
  // fires in parallel"). curtisclan-transactions carries Plaid ingest,
  // categorization, and reply-resolution jobs; curtisclan-messages
  // carries only outbound Sendblue sends, at low concurrency so bursts of
  // new transactions don't fire several texts at once.
  "queues": {
    "producers": [
      { "binding": "TRANSACTION_QUEUE", "queue": "curtisclan-transactions" },
      { "binding": "MESSAGE_QUEUE", "queue": "curtisclan-messages" }
    ],
    "consumers": [
      { "queue": "curtisclan-transactions", "max_batch_size": 10, "max_retries": 5, "max_concurrency": 5 },
      { "queue": "curtisclan-messages", "max_batch_size": 5, "max_retries": 5, "max_concurrency": 1 }
    ]
  },

  // Two schedules, branched on in src/index.ts's scheduled() via
  // controller.cron (must match HOURLY_SYNC_CRON / DAILY_DIGEST_CRON
  // there exactly):
  //   0 * * * *  — the hourly cycle: /transactions/sync for every active
  //                Plaid item, then one batched text about whatever that
  //                hour brought in and couldn't categorize
  //                (src/messaging/hourlyCheckin.ts). Also what makes a
  //                dropped Plaid webhook cost an hour instead of a day
  //                (PLAN §4.2: "they get dropped").
  //   0 13 * * * — morning digest of the last 24 hours of automatic
  //                filings, 13:00 UTC ≈ 6-7am Mountain depending on DST.
  //   */5 * * * * — the Google Sheet sync (src/sheets/sync.ts): apply what
  //                people typed into the sheet, then refresh it.
  "triggers": {
    "crons": ["0 * * * *", "0 13 * * *", "*/5 * * * *"]
  },

  "vars": {
    "ENVIRONMENT": "development"
  },

  // Workers Logs (Cloudflare dashboard → Workers → curtisclan → Logs):
  // persists console.log/error output and invocation metadata server-side
  // instead of only being visible while `wrangler tail` is attached live.
  // head_sampling_rate: 1 means log every invocation (fine at this traffic
  // volume; lower it if usage grows and log volume gets noisy/costly).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }

  // Secrets (Plaid client id/secret, Sendblue keys, Anthropic key, token
  // encryption key) are set with `wrangler secret put <NAME>` per
  // PLAN.md §10 — never listed here. Exact commands: README "Secrets".
}
